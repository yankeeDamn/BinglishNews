# Firebase Configuration
# Get these values from your Firebase Console → Project Settings → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public site URL (used for canonical URLs, sitemap and social previews).
# Optional on Vercel, which falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Optional publisher contact displayed on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional GA4 measurement ID (G-...); loaded only with reader consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=
